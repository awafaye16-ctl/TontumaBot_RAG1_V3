# ─────────────────────────────────────────────────────
#  TontumaBot V3 — Configuration
#  Copier ce fichier en .env et renseigner les clés
# ─────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────
# Fournisseur : groq | gemini | local
LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=

# Modèles cloud
GROQ_MODEL=openai/gpt-oss-120b     # rapide (adapter selon l'accès du compte).
                                   # Attention : ce modèle raisonne avant de répondre,
                                   # et sa trace interne (~200 jetons) est comptée
                                   # dans LLM_MAX_TOKENS ci-dessous.
GEMINI_MODEL=gemini-3.6-flash

# Modèle local (utilisé si LLM_PROVIDER=local)
# Téléchargé depuis HuggingFace Hub au premier appel
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_QUANT=4bit     # 4bit | 8bit | fp16

# Longueur de la réponse. Elle est lue à voix haute : la synthèse coûte ~2 s
# par seconde d'audio, donc raccourcir est le premier levier de latence.
# Mesuré sur 20 questions : 332 → 222 caractères en moyenne, 903 → 473 au pire.
LLM_MAX_PHRASES=3        # consigne donnée au modèle ; c'est elle qui règle la longueur
LLM_MAX_TOKENS=800       # garde-fou seulement. Ne pas serrer : la trace de
                         # raisonnement du modèle y est comptée, et à 220 jetons
                         # 7 réponses sur 20 revenaient vides.

# ── Mémoire conversationnelle ─────────────────────────
# Historique par session, pour comprendre les questions de suite (« et le coût ? »).
# Au-delà de MEMORY_MAX_MESSAGES entrées, la mémoire est VIDÉE (pas la session) :
# la borne l'annonce à l'écran, sans quoi les questions de suite cesseraient
# d'être comprises sans explication.
MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES=10   # 10 entrées = 5 échanges question/réponse
MEMORY_TTL_MINUTES=120   # purge des sessions inactives

# ── Traduction — un seul modèle pour les deux directions ──
# WO→FR et FR→WO (benchmark : bilalfaye meilleur sur domaine administratif)
NLLB_WO_FR_MODEL=bilalfaye/nllb-200-distilled-600M-wo-fr-en
NLLB_NUM_BEAMS=2         # 2 = qualité, 1 = greedy (plus rapide)

# ── STT — un moteur par langue ────────────────────────
# Wolof : soynade-research/Wolof-HuBERT-CTC (dossier local ou Hub)
STT_WO_MODEL=./src/stt_wolof-hubert-ctc
# Français : Whisper. small = 971 Mo / ~1,3 s par question sur CPU.
# Pour plus de précision en audio bruité (et si GPU ou ~2 Go de disque libre) :
#   STT_FR_MODEL=openai/whisper-large-v3-turbo
STT_FR_MODEL=openai/whisper-small
# Langue utilisée si la requête n'en précise pas (la borne l'envoie toujours)
STT_LANGUAGE=wo

# ── Embeddings ────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── TTS (Oolel-Voices) ────────────────────────────────
OOLEL_TTS_REPO=soynade-research/Oolel-Voices
TTS_SPEED=1.0            # 1.0 = normal, >1 ralentit
TTS_N_STEPS=10           # 10 = qualité max, 4 = rapide (~2.5x)
TTS_CHUNK_CHARS=200      # longueur d'un morceau de synthèse ; 0 = pas de découpage
TTS_CHUNK_PAUSE_MS=120   # silence inséré entre deux morceaux

# ── Reranker ──────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# ── Warm-up des modèles au démarrage ──────────────────
# Précharge les modèles au lancement pour éviter la latence au 1er appel.
WARMUP_ON_START=true
WARMUP_STT=true          # false = STT chargé au 1er audio seulement
WARMUP_TTS=true          # false = TTS chargé au 1er TTS seulement
                         # true = chargement + synthèse à vide (~60 s sur M1),
                         #        la 1re synthèse d'un processus est la plus lente

# Plafond mémoire GPU sur Apple Metal (fraction de la mémoire recommandée).
# 0.9 = réservation bornée à ~9,8 Go sur un M1 16 Go. Par défaut PyTorch monte
# jusqu'à 1,7x, ce qui fait tuer le serveur par le système. 0 = pas de plafond.
MPS_MEMORY_RATIO=0.9

# ── Backend de calcul (CPU / CUDA / MPS) ─────────────────────────────────
# auto = cuda si disponible, sinon mps (Apple Silicon), sinon cpu.
# DEVICE impose le backend de tout le pipeline.
DEVICE=auto
#
# Surcharge par composant — utile pour isoler un modèle qui pose problème
# sur un backend donné sans dégrader les autres. Laisser vide = suit DEVICE.
# Valeurs acceptées : auto, cpu, cuda, mps
# STT_DEVICE=
# NLLB_DEVICE=
# TTS_DEVICE=
# EMBEDDER_DEVICE=
# RERANKER_DEVICE=
# LLM_DEVICE=

# ── Journalisation ───────────────────────────────────────
# Une ligne de terminal porte : heure à la ms, niveau, identifiant de requête,
# composant, message. L'identifiant est ce qui permet de démêler deux usagers
# qui parlent en même temps.
LOG_LEVEL=INFO           # DEBUG affiche chaque étape du pipeline avec son heure
LOG_FILE=                # chemin d'un fichier (rotation à 5 Mo, 3 archives) ;
                         # vide = terminal seulement
LOG_COULEUR=auto         # auto | oui | non — auto = couleurs si un humain regarde

# ── Serveur ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8008

# HTTPS (optionnel) — requis pour utiliser le micro depuis un téléphone ou une
# autre machine : les navigateurs réservent getUserMedia aux origines sécurisées.
# Générer un certificat de confiance en local :  mkcert -install && mkcert localhost 192.168.1.X
# SSL_CERTFILE=./certs/localhost.pem
# SSL_KEYFILE=./certs/localhost-key.pem

# ── Docker ───────────────────────────────────────────
# Cache HuggingFace partagé avec l'hôte, monté dans le conteneur.
# setup.sh le renseigne automatiquement (~/.cache/huggingface).
HF_CACHE_DIR=

# ─────────────────────────────────────────────────────────────────────────────
#  Multi-tenant — une base vectorielle par organisation (V3.1)
# ─────────────────────────────────────────────────────────────────────────────
# Chaque structure (mairie, hôpital, préfecture) a sa PROPRE base, dans son
# propre répertoire : CHROMA_ROOT/{organization_id}/. L'isolation est
# structurelle — une recherche dans la base A ne peut pas atteindre B.
CHROMA_ROOT=./data/chroma

# Bases tenues ouvertes simultanément (cache LRU). Chaque organisation chargée
# coûte ~5 Mo pour 1 000 fragments, plus une connexion SQLite.
MAX_ORGANISATIONS_EN_CACHE=20

# Organisation utilisée par les OUTILS INTERNES (benchmark, ingestion en ligne
# de commande). L'API, elle, exige toujours un organization_id explicite.
ORGANISATION_OUTILS=00000000-0000-4000-8000-000000000001

# Repli sur les documents de démonstration quand une organisation est vide.
# LAISSER À false EN PRODUCTION : une structure fraîchement créée répondrait
# sinon avec les procédures génériques du jeu de démo, présentées à l'usager
# comme les siennes.
SEED_FALLBACK=false

# ⚠ EMBED_MODEL ne se change pas à chaud. Le modifier invalide les index de
# TOUTES les organisations : les vecteurs stockés ne sont plus comparables aux
# nouveaux. Le service refuse alors d'ouvrir les bases concernées (409) au lieu
# de les purger. Un changement impose une réindexation complète, planifiée.

# ─────────────────────────────────────────────────────────────────────────────
#  Stockage objet MinIO / S3 — ingestion par pointeur (V3.1)
# ─────────────────────────────────────────────────────────────────────────────
# Le backend dépose le fichier sur MinIO puis notifie l'IA avec bucket +
# objectKey. Accès LECTURE SEULE : l'IA n'écrit jamais sur le stockage.
# Laisser vide désactive cette voie ; l'ingestion directe multipart reste
# disponible et le service démarre normalement.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# OBLIGATOIRE pour MinIO. Les clients S3 utilisent par défaut l'adressage par
# sous-domaine (bucket.hôte/objet), que MinIO ne sert pas : sans ce réglage,
# tous les téléchargements échouent en résolution DNS, avec un message qui ne
# désigne pas la cause.
S3_PATH_STYLE_ACCESS=true

# Plafond de taille d'un objet téléchargé, en mégaoctets.
S3_MAX_MB=50
