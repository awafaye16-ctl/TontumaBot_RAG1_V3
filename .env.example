# ─────────────────────────────────────────────────────
#  TontumaBot V3 — Configuration
#  Copier ce fichier en .env et renseigner les clés
# ─────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────
# Fournisseur : groq | gemini | local
LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=

# Modèle local (utilisé si LLM_PROVIDER=local)
# Téléchargé depuis HuggingFace Hub au premier appel
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_QUANT=4bit     # 4bit | 8bit | fp16

# ── Traduction — deux modèles distincts ──────────────
# WO→FR (benchmark : bilalfaye meilleur sur domaine administratif)
NLLB_WO_FR_MODEL=bilalfaye/nllb-200-distilled-600M-wo-fr-en

# FR→WO (benchmark : Lahad produit un wolof plus naturel)
NLLB_FR_WO_MODEL=Lahad/nllb200-francais-wolof

# ── STT ───────────────────────────────────────────────
# Chemin local du modèle M9and2M/whisper-small-wolof
# (déjà présent dans V3/wolof-whisper-small-lora/)
STT_MODEL_PATH=./wolof-whisper-small-lora
STT_LANGUAGE=

# ── Embeddings ────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── TTS ───────────────────────────────────────────────
# Moteur principal : oolel (benchmark : meilleure qualité vocale)
# Fallbacks automatiques : speecht5 → edge-tts
TTS_ENGINE=oolel
OOLEL_TTS_REPO=soynade-research/Oolel-Voices
WOLOF_TTS_MODEL=bilalfaye/speecht5_tts-wolof-v0.2

# ── Reranker ──────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# ── Serveur ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
